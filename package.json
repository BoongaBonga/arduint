{
  "name": "arduint",
  "displayName": "Arduint",
  "description": "Language support and executing features for the Arduino interpreter language. \nA language to make Arduino accesible to all without having to program using blocks. (We're not babies)",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "arduint",
        "aliases": ["Arduint", "arduint"],
        "extensions": [
          ".ardi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "arduint",
        "scopeName": "source.arduint",
        "path": "./syntaxes/arduint.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "arduint.runLexer",
        "title": "Arduino Interpreter: Run Lexer & Print Tokens"
      }
    ],
    "keybindings": [
      {
        "command": "arduint.runLexer",
        "key": "ctrl+alt+l",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
