{
  "scopeName": "source.arduint",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.arduint",
          "match": "//.*$"
        },
        {
          "name": "comment.block.arduint",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.arduint",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.arduint",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.arduint",
          "match": "\\b([Aa]nd|[Nn]ot|[Oo]r|[Ee]quals|[Ii]f|[Ee]lse|[Ww]hile|[Ff]or|[Rr]eturn|[Ff]unction|[Ll]oop|[Dd]efine|[Aa]s|[Tt]o)\\b"
        },
        {
          "name": "constant.language.boolean.arduint",
          "match": "\\b([Tt]rue|[Ff]alse)\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.arduint",
      "match": "\\b\\d+(\\.\\d+)?(ms|\\u00B5s|micros|s|h|m)?\\b"
    },
    "functions": {
      "name": "support.function.arduint",
      "match": "\\b([Ss]etPin|[Rr]eadPin|[Dd]elayMicros|[Dd]elay|[Pp]rint)\\b"
    }
  }
}
